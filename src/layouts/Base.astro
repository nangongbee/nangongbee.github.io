---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const site = 'https://nangongbee.github.io';
const canonical = new URL(path, site).toString();
const fullTitle = title === 'Tim Wu' ? title : `${title} · Tim Wu`;
const nav = [
  ['/', 'Home'],
  ['/about/', 'About'],
  ['/projects/', 'Projects'],
  ['/blog/', 'Blog'],
  ['/contact/', 'Contact'],
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tim Wu',
  url: site,
  email: 'bumble.timwu@gmail.com',
  jobTitle: 'Software Engineer',
  description:
    'I build software systems with a focus on architecture, reliability, and real-world engineering.',
  sameAs: ['https://github.com/nangongbee'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Tim Wu" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tim Wu" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Tim Wu</a>
        <nav>
          {
            nav.map(([href, label]) => (
              <a href={href} aria-current={path === href ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <a href="https://github.com/nangongbee">GitHub</a>
        <span> · </span>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
