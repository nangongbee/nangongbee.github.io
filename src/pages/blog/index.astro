---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/posts';
---

<Base
  title="Blog"
  description="Technical notes on software architecture, systems engineering, and practical implementation."
  path="/blog/"
>
  <h1>Blog</h1>
  <p>Technical notes on software architecture, systems engineering, and practical implementation.</p>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={post.href}>{post.title}</a>
          <div class="meta">
            {post.pubDate}
            {post.archived ? ' · Archived' : ''}
          </div>
        </li>
      ))
    }
  </ul>
</Base>
